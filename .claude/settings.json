{
  "permissions": {
    "deny": [
      "Bash(python orchestrator.py approve:*)",
      "Bash(python3 orchestrator.py approve:*)",
      "Bash(py orchestrator.py approve:*)",
      "Bash(python -m orchestrator approve:*)",
      "Bash(python orchestrator.py reject:*)",
      "Bash(python3 orchestrator.py reject:*)",
      "Bash(py orchestrator.py reject:*)",
      "Bash(python -m orchestrator reject:*)",
      "Bash(python orchestrator.py reopen:*)",
      "Bash(python3 orchestrator.py reopen:*)",
      "Bash(py orchestrator.py reopen:*)",
      "Bash(python -m orchestrator reopen:*)",
      "PowerShell(python orchestrator.py approve:*)",
      "PowerShell(python orchestrator.py reject:*)",
      "PowerShell(python orchestrator.py reopen:*)",
      "Edit(/sdlc/**)",
      "Edit(/orchestrator.py)",
      "Edit(/hooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/commands/**)",
      "Edit(/.claude/skills/**)",
      "Write(/sdlc/**)",
      "Write(/orchestrator.py)",
      "Write(/hooks/**)",
      "Write(/.claude/settings.json)",
      "Write(/.claude/agents/**)",
      "Write(/.claude/commands/**)",
      "Write(/.claude/skills/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
